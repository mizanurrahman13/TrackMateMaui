<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackMateMaui.ViewModels"
             x:Class="TrackMateMaui.Views.ListOfTaskPage">

    <Label Text="{Binding Tasks.Count}" FontSize="24" TextColor="Red" HorizontalOptions="Center" />

    <CollectionView ItemsSource="{Binding Tasks}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Stroke="Gray" StrokeThickness="1" Margin="10" Padding="10" BackgroundColor="White" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="Row Loaded" TextColor="Green" />
                        <Label Text="{Binding Id}" />
                        <Label Text="{Binding Name}" />
                        <Label Text="{Binding Description}" />
                        <Label Text="{Binding Category}" />
                        <Label Text="{Binding Priority}" />
                        <Label Text="{Binding Status}" />
                        <Label Text="{Binding StartedAt}" />
                        <Label Text="{Binding EndAt}" />
                        <Label Text="{Binding .}" TextColor="Blue" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
